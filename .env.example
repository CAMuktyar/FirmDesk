PORT=4000
# Optional local account storage; MongoDB backs tasks, clients, and conversations
MONGODB_URI=
# Optional comma-separated DNS resolvers for MongoDB SRV lookup issues
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins for production/preview frontend URLs
ALLOWED_ORIGINS=
SESSION_HOURS=8

# Optional bootstrap for the first admin. If omitted, run npm run create-admin.
ADMIN_NAME=CA Owner
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Generate VAPID keys for background device push notifications. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
